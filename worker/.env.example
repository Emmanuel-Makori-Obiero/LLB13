# Supabase project settings. Never expose the service-role key to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# ComfyUI must be running with an API-format workflow loaded/configured.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_JSON=/opt/ComfyUI/workflows/llb13-wan-api.json
COMFYUI_OUTPUT_DIR=/opt/ComfyUI/output

# The worker generates many short units and stitches them into each segment.
GENERATION_CLIP_SECONDS=5
COMFYUI_JOB_TIMEOUT_SECONDS=1800
WORKER_IDLE_SECONDS=15
WORKER_POLL_SECONDS=3
# Set to 1 for a single test project, then remove it for a long-running worker.
WORKER_ONCE=0
