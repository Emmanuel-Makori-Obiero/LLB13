+          onChange={(e) => setFocus(e.target.value)}
+        />
+        <div className="ex-actions">
+          <button
+            type="button"
+            className="primary-button"
+            disabled={busy === "build"}
+            onClick={() => void build()}
+          >
+            {busy === "build" ? (
+              <>
+                <Loader2 size={14} className="sa-spin" /> Reading the book…
+              </>
+            ) : (
+              "Build my study path"
+            )}
+          </button>
+        </div>
+        {err && <div className="connection-error">{err}</div>}
+      </div>
+
+      {paths.length > 0 && (
+        <div className="card card-pad">
+          <div className="eyebrow">Continue</div>
+          <h2>Your paths.</h2>
+          {paths.map((p) => {
