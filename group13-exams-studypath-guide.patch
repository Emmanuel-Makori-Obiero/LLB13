diff --git a/src/Copilot.tsx b/src/Copilot.tsx
new file mode 100644
index 0000000..47cd183
--- /dev/null
+++ b/src/Copilot.tsx
@@ -0,0 +1,173 @@
+import { useEffect, useRef, useState } from "react";
+import { Bot, Loader2, Send, X } from "lucide-react";
+import { askAI } from "./lib/ai";
+import "./learn.css";
+
+type Go = { page: string; label: string };
+type Turn = { role: "user" | "assistant"; content: string; go?: Go[]; failed?: boolean };
+
+const IDEAS = [
+  "Make me a practice exam",
+  "Teach me a unit step by step",
+  "What's due this week?",
+  "Help me with my research paper",
+];
+
+/** A small floating helper on every page: tell it what you want and it opens the right page or answers. */
+export function Copilot({
+  view,
+  onNavigate,
+}: {
+  view: string;
+  onNavigate: (page: string) => void;
+}) {
+  const [open, setOpen] = useState(false);
+  const [turns, setTurns] = useState<Turn[]>([]);
+  const [input, setInput] = useState("");
+  const [busy, setBusy] = useState(false);
+  const end = useRef<HTMLDivElement>(null);
+  const field = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    if (open) {
+      field.current?.focus();
+      end.current?.scrollIntoView({ block: "nearest" });
+    }
+  }, [open, turns, busy]);
+
+  useEffect(() => {
+    if (!open) return;
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape") setOpen(false);
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [open]);
+
+  const send = async (text: string) => {
+    const t = text.trim();
+    if (!t || busy) return;
+    const next: Turn[] = [...turns.filter((x) => !x.failed), { role: "user", content: t }];
+    setTurns(next);
+    setInput("");
+    setBusy(true);
+    try {
+      const r = await askAI({
+        feature: "copilot",
+        mode: "general",
+        messages: next.slice(-8).map(({ role, content }) => ({ role, content })),
+        payload: { page: view },
+      });
+      const d = (r.data ?? {}) as { reply?: string; go?: Go[] };
+      setTurns([
+        ...next,
+        { role: "assistant", content: d.reply || r.answer, go: Array.isArray(d.go) ? d.go : [] },
+      ]);
+    } catch (e) {
+      setTurns([...next, { role: "assistant", content: (e as Error).message, failed: true }]);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <>
+      {!open && (
+        <button
+          type="button"
+          className="cp-fab"
+          aria-label="Tell me what you want to do"
+          title="Tell me what you want to do"
+          onClick={() => setOpen(true)}
+        >
+          <Bot size={22} />
+        </button>
+      )}
+      {open && (
+        <section className="cp-panel" aria-label="Guide">
+          <header className="cp-head">
+            <strong>Tell me what you want to do</strong>
+            <button
+              type="button"
+              className="icon-button"
+              aria-label="Close"
+              onClick={() => setOpen(false)}
+            >
+              <X size={16} />
+            </button>
+          </header>
+          <div className="cp-log" aria-live="polite">
+            {turns.length === 0 && (
+              <div className="cp-ideas">
+                <p>
+                  I can open the right page for you, answer a quick question, or
+                  tell you what's coming up.
+                </p>
+                {IDEAS.map((i) => (
+                  <button type="button" key={i} onClick={() => void send(i)}>
+                    {i}
+                  </button>
+                ))}
+              </div>
+            )}
+            {turns.map((t, i) => (
+              <div key={i} className={`cp-msg ${t.role === "user" ? "me" : "bot"}`}>
+                {t.failed ? (
+                  <div className="connection-error">{t.content}</div>
+                ) : (
+                  <p>{t.content}</p>
+                )}
+                {t.go && t.go.length > 0 && (
+                  <div className="cp-go">
+                    {t.go.map((g) => (
+                      <button
+                        type="button"
+                        key={g.page}
+                        className="primary-button"
+                        onClick={() => {
+                          onNavigate(g.page);
+                          setOpen(false);
+                        }}
+                      >
+                        {g.label}
+                      </button>
+                    ))}
+                  </div>
+                )}
+              </div>
+            ))}
+            {busy && (
+              <div className="cp-msg bot">
+                <Loader2 size={14} className="sa-spin" />
+              </div>
+            )}
+            <div ref={end} />
+          </div>
+          <form
+            className="cp-input"
+            onSubmit={(e) => {
+              e.preventDefault();
+              void send(input);
+            }}
+          >
+            <input
+              ref={field}
+              value={input}
+              maxLength={500}
+              placeholder="e.g. I want to practise for my exam"
+              onChange={(e) => setInput(e.target.value)}
+            />
+            <button
+              type="submit"
+              className="primary-button"
+              disabled={busy || !input.trim()}
+              aria-label="Send"
+            >
+              <Send size={14} />
+            </button>
+          </form>
+        </section>
+      )}
+    </>
+  );
+}
diff --git a/src/ExamPage.tsx b/src/ExamPage.tsx
new file mode 100644
index 0000000..f1abc2a
--- /dev/null
+++ b/src/ExamPage.tsx
@@ -0,0 +1,839 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import {
+  FileUp,
+  Globe,
+  Loader2,
+  Lock,
+  Play,
+  RotateCcw,
+  Trash2,
+} from "lucide-react";
+import { supabase } from "./data/repository";
+import type { Unit } from "./data/types";
+import { askAI, extractText } from "./lib/ai";
+import "./learn.css";
+
+type QType = "problem" | "essay" | "short";
+type ExamQuestion = {
+  id: string;
+  number: number;
+  type: QType;
+  text: string;
+  marks: number;
+  topics: string[];
+};
+type Exam = {
+  title: string;
+  instructions: string;
+  duration_minutes: number;
+  questions: ExamQuestion[];
+};
+type Grading = {
+  score: number;
+  max: number;
+  verdict: string;
+  strengths: string[];
+  errors: { quote: string; problem: string; fix: string }[];
+  missed_points: string[];
+  outline: string[];
+  improved_opening: string;
+  study_next: string[];
+};
+type Attempt = {
+  id: string;
+  title: string;
+  unit: string | null;
+  paper_ids: string[];
+  exam: Exam;
+  answers: Record<string, string>;
+  results: Record<string, Grading> | null;
+  score: number | null;
+  max_score: number | null;
+  status: "in_progress" | "graded";
+  created_at: string;
+};
+type AttemptRow = Pick<
+  Attempt,
+  "id" | "title" | "unit" | "score" | "max_score" | "status" | "created_at"
+>;
+type Paper = {
+  id: string;
+  owner: string;
+  owner_name: string | null;
+  title: string;
+  unit: string | null;
+  year: number | null;
+  visibility: "private" | "group";
+  created_at: string;
+};
+
+const MAX_PAPERS = 6;
+const wordCount = (t: string) => (t.trim() ? t.trim().split(/\s+/).length : 0);
+const pct = (a: number, b: number) => (b > 0 ? Math.round((a / b) * 100) : 0);
+const band = (p: number) =>
+  p >= 70
+    ? "Strong"
+    : p >= 60
+      ? "Good"
+      : p >= 50
+        ? "Pass"
+        : p >= 40
+          ? "Borderline"
+          : "Needs work";
+const mmss = (s: number) =>
+  `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
+
+export function ExamPage({
+  units,
+  userId,
+}: {
+  units: Unit[];
+  userId: string | null;
+}) {
+  const [papers, setPapers] = useState<Paper[]>([]);
+  const [attempts, setAttempts] = useState<AttemptRow[]>([]);
+  const [picked, setPicked] = useState<string[]>([]);
+  const [active, setActive] = useState<Attempt | null>(null);
+  const [answers, setAnswers] = useState<Record<string, string>>({});
+  const [note, setNote] = useState("");
+  const [busy, setBusy] = useState<"" | "upload" | "generate" | "grade">("");
+  const [gradeErrors, setGradeErrors] = useState<Record<string, string>>({});
+  const [gradingNow, setGradingNow] = useState("");
+  // upload form
+  const [upTitle, setUpTitle] = useState("");
+  const [upUnit, setUpUnit] = useState("");
+  const [upYear, setUpYear] = useState("");
+  const [upVis, setUpVis] = useState<"private" | "group">("private");
+  const fileRef = useRef<HTMLInputElement>(null);
+  const [file, setFile] = useState<File | null>(null);
+  // build form
+  const [count, setCount] = useState(4);
+  const [minutes, setMinutes] = useState(120);
+  const [difficulty, setDifficulty] = useState("exam");
+  const [focus, setFocus] = useState("");
+  const [buildUnit, setBuildUnit] = useState("");
+  // timer
+  const [startedAt, setStartedAt] = useState(Date.now());
+  const [now, setNow] = useState(Date.now());
+
+  const loadPapers = useCallback(async () => {
+    if (!supabase) return;
+    const { data } = await supabase
+      .from("exam_papers")
+      .select("id,owner,owner_name,title,unit,year,visibility,created_at")
+      .order("created_at", { ascending: false });
+    setPapers((data as Paper[] | null) ?? []);
+  }, []);
+  const loadAttempts = useCallback(async () => {
+    if (!supabase) return;
+    const { data } = await supabase
+      .from("exam_attempts")
+      .select("id,title,unit,score,max_score,status,created_at")
+      .order("created_at", { ascending: false })
+      .limit(20);
+    setAttempts((data as AttemptRow[] | null) ?? []);
+  }, []);
+  useEffect(() => {
+    void loadPapers();
+    void loadAttempts();
+  }, [loadPapers, loadAttempts]);
+
+  useEffect(() => {
+    if (!active || active.status === "graded") return;
+    const t = setInterval(() => setNow(Date.now()), 1000);
+    return () => clearInterval(t);
+  }, [active]);
+
+  // autosave answers while sitting
+  const saveTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
+  const activeId = active?.id;
+  const sitting = active?.status === "in_progress";
+  useEffect(() => {
+    if (!supabase || !activeId || !sitting) return;
+    if (saveTimer.current) clearTimeout(saveTimer.current);
+    saveTimer.current = setTimeout(() => {
+      void supabase!.from("exam_attempts").update({ answers }).eq("id", activeId);
+    }, 1500);
+    return () => {
+      if (saveTimer.current) clearTimeout(saveTimer.current);
+    };
+  }, [answers, activeId, sitting]);
+
+  const toggle = (id: string) =>
+    setPicked((p) =>
+      p.includes(id)
+        ? p.filter((x) => x !== id)
+        : p.length >= MAX_PAPERS
+          ? p
+          : [...p, id],
+    );
+
+  const upload = async () => {
+    if (!supabase || !file) return;
+    setBusy("upload");
+    setNote("");
+    try {
+      const text = (await extractText(file)).trim();
+      if (text.length < 50)
+        throw new Error(
+          "No readable text found. Scanned PDFs need OCR before upload.",
+        );
+      const year = Number(upYear);
+      const { data, error } = await supabase
+        .from("exam_papers")
+        .insert({
+          title: (upTitle || file.name.replace(/\.[^.]+$/, "")).slice(0, 200),
+          unit: upUnit || null,
+          year: Number.isInteger(year) && year >= 1980 && year <= 2100 ? year : null,
+          content: text.slice(0, 150000),
+          visibility: upVis,
+        })
+        .select("id")
+        .single();
+      if (error) throw new Error(error.message);
+      setPicked((p) => [...p, (data as { id: string }).id].slice(-MAX_PAPERS));
+      setFile(null);
+      setUpTitle("");
+      setUpYear("");
+      if (fileRef.current) fileRef.current.value = "";
+      setNote(
+        text.length > 150000
+          ? "Uploaded. Only the first part of a very long paper is kept."
+          : "Past paper uploaded.",
+      );
+      void loadPapers();
+    } catch (e) {
+      setNote((e as Error).message);
+    } finally {
+      setBusy("");
+    }
+  };
+
+  const setVisibility = async (p: Paper, visibility: "private" | "group") => {
+    await supabase?.from("exam_papers").update({ visibility }).eq("id", p.id);
+    void loadPapers();
+  };
+  const removePaper = async (p: Paper) => {
+    if (!window.confirm(`Delete "${p.title}"?`)) return;
+    await supabase?.from("exam_papers").delete().eq("id", p.id);
+    setPicked((x) => x.filter((id) => id !== p.id));
+    void loadPapers();
+  };
+
+  const generate = async () => {
+    if (!supabase) return;
+    setBusy("generate");
+    setNote("");
+    try {
+      const r = await askAI({
+        feature: "exam_generate",
+        mode: "general",
+        messages: [{ role: "user", content: "Generate the practice exam." }],
+        payload: {
+          paperIds: picked,
+          count,
+          minutes,
+          difficulty,
+          topic: focus,
+          unit: buildUnit,
+        },
+      });
+      const exam = r.data as Exam | null;
+      if (!exam?.questions?.length) throw new Error("No exam came back. Try again.");
+      const { data, error } = await supabase
+        .from("exam_attempts")
+        .insert({
+          title: exam.title,
+          unit: buildUnit || null,
+          paper_ids: picked,
+          exam,
+          duration_minutes: exam.duration_minutes,
+        })
+        .select("*")
+        .single();
+      if (error) throw new Error(error.message);
+      setAnswers({});
+      setGradeErrors({});
+      setStartedAt(Date.now());
+      setNow(Date.now());
+      setActive(data as Attempt);
+      void loadAttempts();
+    } catch (e) {
+      setNote((e as Error).message);
+    } finally {
+      setBusy("");
+    }
+  };
+
+  const open = async (id: string) => {
+    if (!supabase) return;
+    const { data } = await supabase
+      .from("exam_attempts")
+      .select("*")
+      .eq("id", id)
+      .single();
+    if (!data) return;
+    const a = data as Attempt;
+    setActive(a);
+    setAnswers(a.answers ?? {});
+    setGradeErrors({});
+    setStartedAt(Date.now());
+    setNow(Date.now());
+    window.scrollTo({ top: 0, behavior: "smooth" });
+  };
+
+  const removeAttempt = async (id: string) => {
+    if (!window.confirm("Delete this exam and its marks?")) return;
+    await supabase?.from("exam_attempts").delete().eq("id", id);
+    if (active?.id === id) setActive(null);
+    void loadAttempts();
+  };
+
+  const submit = async () => {
+    if (!supabase || !active) return;
+    setBusy("grade");
+    setNote("");
+    const exam = active.exam;
+    const results: Record<string, Grading> = { ...(active.results ?? {}) };
+    const errs: Record<string, string> = {};
+    for (const q of exam.questions) {
+      if (results[q.id]) continue;
+      setGradingNow(`Marking question ${q.number} of ${exam.questions.length}…`);
+      try {
+        const r = await askAI({
+          feature: "exam_grade",
+          mode: "general",
+          messages: [{ role: "user", content: "Mark this answer." }],
+          payload: {
+            question: { id: q.id, text: q.text, marks: q.marks, type: q.type },
+            answer: answers[q.id] ?? "",
+            paperIds: active.paper_ids,
+          },
+        });
+        results[q.id] = r.data as Grading;
+        setActive((a) => (a ? { ...a, results: { ...results } } : a));
+      } catch (e) {
+        errs[q.id] = (e as Error).message;
+      }
+    }
+    setGradeErrors(errs);
+    setGradingNow("");
+    const complete = exam.questions.every((q) => results[q.id]);
+    const score = exam.questions.reduce((s, q) => s + (results[q.id]?.score ?? 0), 0);
+    const max = exam.questions.reduce((s, q) => s + q.marks, 0);
+    const patch = {
+      answers,
+      results,
+      score,
+      max_score: max,
+      status: complete ? "graded" : "in_progress",
+    };
+    await supabase.from("exam_attempts").update(patch).eq("id", active.id);
+    setActive((a) =>
+      a ? ({ ...a, ...patch } as Attempt) : a,
+    );
+    if (!complete)
+      setNote(
+        "Some questions could not be marked. Press Retry to mark just those.",
+      );
+    setBusy("");
+    void loadAttempts();
+  };
+
+  const mine = papers.filter((p) => p.owner === userId);
+  const shared = papers.filter((p) => p.owner !== userId);
+  const dur = active?.exam.duration_minutes ?? 0;
+  const elapsed = Math.max(0, Math.floor((now - startedAt) / 1000));
+
+  // ---------- sitting / results ----------
+  if (active) {
+    const exam = active.exam;
+    const graded = active.status === "graded";
+    const hasResults = !!active.results && Object.keys(active.results).length > 0;
+    const total = exam.questions.reduce((s, q) => s + q.marks, 0);
+    const got = exam.questions.reduce(
+      (s, q) => s + (active.results?.[q.id]?.score ?? 0),
+      0,
+    );
+    const failedIds = exam.questions
+      .filter((q) => !active.results?.[q.id] && hasResults)
+      .map((q) => q.id);
+    return (
+      <div className="ex">
+        <div className="card card-pad">
+          <div className="ex-head">
+            <div>
+              <div className="eyebrow">
+                {graded ? "Marked" : "Exam in progress"}
+              </div>
+              <h2>{exam.title}</h2>
+            </div>
+            <button
+              type="button"
+              className="secondary-button"
+              onClick={() => {
+                setActive(null);
+                void loadAttempts();
+              }}
+            >
+              Back to exams
+            </button>
+          </div>
+          {exam.instructions && <p className="ex-instr">{exam.instructions}</p>}
+          {!graded && (
+            <p className="field-hint">
+              Suggested time: {dur} minutes. You have been going for{" "}
+              {mmss(elapsed)}. The clock is only a guide and nothing stops
+              when it runs out.
+            </p>
+          )}
+          {hasResults && (
+            <div className="ex-score">
+              <strong>
+                {got} / {total}
+              </strong>
+              <span>
+                {pct(got, total)}% · {band(pct(got, total))}
+              </span>
+            </div>
+          )}
+        </div>
+
+        {exam.questions.map((q) => {
+          const g = active.results?.[q.id];
+          return (
+            <div className="card card-pad ex-q" key={q.id}>
+              <div className="ex-qhead">
+                <span className="chip">Question {q.number}</span>
+                <span className="chip">{q.marks} marks</span>
+                <span className="chip">{q.type}</span>
+                {g && (
+                  <span className="ex-got">
+                    {g.score} / {q.marks}
+                  </span>
+                )}
+              </div>
+              <p className="ex-qtext">{q.text}</p>
+              {graded || g ? (
+                <>
+                  <div className="ex-answer">
+                    <div className="section-label">Your answer</div>
+                    <p>{answers[q.id]?.trim() || "(no answer written)"}</p>
+                  </div>
+                  {g ? (
+                    <GradingView g={g} />
+                  ) : (
+                    <div className="connection-error">
+                      {gradeErrors[q.id] ?? "This question has not been marked yet."}
+                    </div>
+                  )}
+                </>
+              ) : (
+                <>
+                  <textarea
+                    className="ex-textarea"
+                    rows={q.type === "short" ? 5 : 11}
+                    value={answers[q.id] ?? ""}
+                    maxLength={30000}
+                    placeholder="Write your answer here…"
