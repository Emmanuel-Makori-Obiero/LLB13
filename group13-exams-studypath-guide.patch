+                </span>
+              )}
+              <button
+                type="button"
+                className="icon-button"
+                aria-label="Delete exam"
+                onClick={() => void removeAttempt(a.id)}
+              >
+                <Trash2 size={14} />
+              </button>
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function GradingView({ g }: { g: Grading }) {
+  return (
+    <div className="ex-grade">
+      {g.verdict && <p className="ex-verdict">{g.verdict}</p>}
+      {g.strengths.length > 0 && (
+        <>
+          <div className="section-label">What you did well</div>
+          <ul>
+            {g.strengths.map((s, i) => (
+              <li key={i}>{s}</li>
+            ))}
+          </ul>
+        </>
+      )}
+      {g.errors.length > 0 && (
+        <>
+          <div className="section-label">Where you went wrong</div>
+          {g.errors.map((e, i) => (
+            <div className="ex-error" key={i}>
+              {e.quote && <blockquote>"{e.quote}"</blockquote>}
+              <p>
+                <strong>Problem:</strong> {e.problem}
+              </p>
+              {e.fix && (
+                <p>
+                  <strong>Fix:</strong> {e.fix}
+                </p>
+              )}
+            </div>
+          ))}
+        </>
+      )}
+      {g.missed_points.length > 0 && (
+        <>
+          <div className="section-label">Points you missed</div>
+          <ul>
+            {g.missed_points.map((s, i) => (
+              <li key={i}>{s}</li>
+            ))}
+          </ul>
+        </>
+      )}
+      {g.outline.length > 0 && (
+        <>
+          <div className="section-label">What a full-marks answer covers</div>
+          <ul>
+            {g.outline.map((s, i) => (
+              <li key={i}>{s}</li>
+            ))}
+          </ul>
+        </>
+      )}
+      {g.improved_opening && (
+        <>
+          <div className="section-label">A stronger version of your weakest part</div>
+          <p className="ex-improved">{g.improved_opening}</p>
+        </>
+      )}
+      {g.study_next.length > 0 && (
+        <>
+          <div className="section-label">Revise next</div>
+          <ul>
+            {g.study_next.map((s, i) => (
+              <li key={i}>{s}</li>
+            ))}
+          </ul>
+        </>
+      )}
+    </div>
+  );
+}
