+              <button
+                type="button"
+                key={t.id}
+                className={`sp-topic ${i === topicIdx ? "on" : ""}`}
+                onClick={() => {
+                  setTopicIdx(i);
+                  setErr("");
+                  setHearingMsg("");
+                }}
+              >
+                <span className="sp-num">
+                  {path.progress[t.id] === "done" ? <Check size={13} /> : i + 1}
+                </span>
+                <span>{t.title}</span>
+              </button>
+            ))}
+          </nav>
+
+          <div className="sp-main">
+            <div className="card card-pad">
+              <div className="eyebrow">
+                Topic {topicIdx + 1} of {path.topics.length}
+              </div>
+              <h2>{topic.title}</h2>
+              <p>{topic.summary}</p>
+              {topic.objectives.length > 0 && (
+                <>
+                  <div className="section-label">By the end you can</div>
+                  <ul>
+                    {topic.objectives.map((o, i) => (
+                      <li key={i}>{o}</li>
+                    ))}
+                  </ul>
+                </>
+              )}
+              {!saved.lesson && (
+                <div className="ex-actions">
+                  <button
+                    type="button"
+                    className="primary-button"
+                    disabled={busy !== ""}
+                    onClick={() => void teach(topic)}
+                  >
+                    {busy === "lesson" ? (
+                      <>
+                        <Loader2 size={14} className="sa-spin" /> Preparing your lesson…
+                      </>
+                    ) : (
+                      <>
+                        <BookOpen size={14} /> Teach me this topic
+                      </>
+                    )}
+                  </button>
+                </div>
+              )}
+              {err && <div className="connection-error">{err}</div>}
+            </div>
+
+            {saved.lesson && (
+              <div className="card card-pad sp-lesson">
+                <div className="sa-basis">
+                  <span className={`sa-badge ${saved.lesson.grounded ? "grounded" : "open"}`}>
+                    {saved.lesson.grounded ? "From your books" : "General law, verify"}
+                  </span>
+                </div>
+                <Markdown text={saved.lesson.answer} />
+                {saved.lesson.warnings.length > 0 && (
+                  <ul className="sa-warnings">
+                    {saved.lesson.warnings.map((w) => (
+                      <li key={w}>{w}</li>
+                    ))}
+                  </ul>
+                )}
+                {saved.lesson.sources.length > 0 && (
+                  <div className="sa-sources">
+                    <div className="section-label">Sources used</div>
+                    {saved.lesson.sources.map((s) => (
+                      <div className="sa-source" key={s.tag}>
+                        <sup className="md-cite">{s.tag}</sup>
+                        <span>
+                          {s.title}
+                          {s.ref ? `, ${s.ref}` : ""}
+                        </span>
+                      </div>
+                    ))}
+                  </div>
+                )}
+                <div className="ex-actions">
+                  <button
+                    type="button"
+                    className="secondary-button"
+                    disabled={busy !== ""}
+                    onClick={() => void teach(topic)}
+                  >
+                    {busy === "lesson" ? "Rewriting…" : "Explain it differently"}
+                  </button>
+                </div>
+              </div>
+            )}
+
+            {saved.lesson && (
+              <div className="card card-pad">
+                <div className="eyebrow">Cases for this topic</div>
+                {!saved.cases ? (
+                  <>
+                    <p className="field-hint">
+                      I list the cases in your books first, then well-known
+                      ones. Each links to a Kenya Law search so you can read
