+import "./learn.css";
+
+type Topic = {
+  id: string;
+  title: string;
+  summary: string;
+  objectives: string[];
+  search: string;
+};
+type CaseItem = {
+  name: string;
+  citation: string;
+  point: string;
+  in_sources: boolean;
+};
+type LessonData = {
+  answer: string;
+  sources: AIResult["sources"];
+  warnings: string[];
+  grounded: boolean;
+};
+type Saved = { lesson?: LessonData; cases?: CaseItem[] };
+type PathRow = {
+  id: string;
+  title: string;
+  focus: string | null;
+  doc_ids: string[];
+  topics: Topic[];
+  progress: Record<string, string>;
+  lessons: Record<string, Saved>;
+  updated_at: string;
+};
+
+const CAUSELIST = "https://causelist.court.go.ke/";
+const kenyaLaw = (q: string) =>
+  `https://new.kenyalaw.org/search/?q=${encodeURIComponent(q)}`;
+
+const nextWeekday = () => {
+  const d = new Date();
+  d.setDate(d.getDate() + 1);
+  while (d.getDay() === 0 || d.getDay() === 6) d.setDate(d.getDate() + 1);
+  const p = (n: number) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}`;
+};
+
+function cleanTopics(raw: unknown): Topic[] {
+  if (!Array.isArray(raw)) return [];
+  return raw
+    .map((t, i) => {
+      const o = (t ?? {}) as Record<string, unknown>;
+      return {
+        id: `t${i + 1}`,
+        title: String(o.title ?? "").trim().slice(0, 160),
+        summary: String(o.summary ?? "").trim().slice(0, 500),
+        objectives: Array.isArray(o.objectives)
+          ? o.objectives.map((x) => String(x).trim().slice(0, 200)).filter(Boolean).slice(0, 5)
+          : [],
+        search: String(o.search ?? "").trim().slice(0, 200),
+      };
+    })
+    .filter((t) => t.title)
+    .slice(0, 14);
+}
+
+export function StudyPath({
+  onAddTodo,
