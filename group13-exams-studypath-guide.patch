+            <span>
+              <strong>{d.title}</strong>
+            </span>
+          </label>
+        ))}
+        <label className="ex-file">
+          <Upload size={15} />
+          <span>{docsApi.uploading ? "Reading…" : "Upload a book or notes"}</span>
+          <input
+            ref={docsApi.fileRef}
+            type="file"
+            accept=".pdf,.docx,.txt,.md"
+            multiple
+            onChange={(e) => void docsApi.upload(e.target.files)}
+          />
+        </label>
+        {docsApi.note && <div className="field-hint">{docsApi.note}</div>}
+
+        <input
+          className="ex-input ex-wide"
+          placeholder="Focus (optional), e.g. Constitutional law: the Bill of Rights"
