+                    </p>
+                    <div className="ex-actions">
+                      <button
+                        type="button"
+                        className="secondary-button"
+                        disabled={busy !== ""}
+                        onClick={() => void findCases(topic)}
+                      >
+                        {busy === "cases" ? "Looking…" : "Find cases"}
+                      </button>
+                      <a
+                        className="sp-link"
+                        href={kenyaLaw(topic.title)}
+                        target="_blank"
