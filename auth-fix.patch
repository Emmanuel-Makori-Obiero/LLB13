+/* ---------- Auth (sign in / sign up) ---------- */
+.auth-page { min-height:100vh; display:grid; place-items:center; padding:24px; background:var(--paper); }
+.auth-shell { width:min(880px,100%); display:grid; grid-template-columns:5fr 6fr; background:var(--white); border:1px solid var(--line); box-shadow:0 24px 70px rgba(22,58,52,.14); }
