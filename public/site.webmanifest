{
  "name": "Law Student Community Hub Kenya",
  "short_name": "Law Study Hub",
  "description": "Study tools for Kenyan law students: guided revision, case-law research, notes and exam practice. Workspace sign-up is limited to approved Group 13 students.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#F7F5F0",
  "theme_color": "#163A34",
  "lang": "en-KE",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
